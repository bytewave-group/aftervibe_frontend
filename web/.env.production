# Loaded by `next build`. One deployment serves one tenant.
# `NEXT_PUBLIC_*` is inlined into the build, so Cloudflare does not need .env.local.
# Local overrides belong in .env.local.
NEXT_PUBLIC_API_BASE_URL=https://fipm6crw6y.voxxclub.vip
NEXT_PUBLIC_API_TENANT_ID=b8ca06a2-7a65-42b3-8672-ad39c788a65a

# Public POS origin for product images such as /uploads/... (no trailing slash).
NEXT_PUBLIC_POS_ASSET_BASE_URL=https://api.foodcourt.group

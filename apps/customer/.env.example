# Central bar list used by the Login / Register bar selector.
# Response: {"success":true,"bars":[{"id":1,"name":"...","domain":"...","url":"https://bar.example.com"}]}
# Defaults to <central API>/bars: https://aftervibe_backend.test/api/bars locally,
# https://api.after-vibe.com/bars when the app runs live (client.after-vibe.com or ?env=live).
VITE_BARS_URL=https://aftervibe_backend.test/api/bars
# Production:
# VITE_BARS_URL=https://api.after-vibe.com/bars

# Optional: forces the live central API when it contains "api.after-vibe.com".
# Customer API calls always go to the selected bar (<bar url>/api), taken from the bar QR `api` param or picked manually.
# VITE_API_URL=https://api.after-vibe.com

# Optional: bearer token for the /visualeffect browser preview (Electron uses IPC instead).
# VITE_BAR_TOKEN=

{
  "name": "aftervibe",
  "private": true,
  "version": "1.4.95",
  "main": "electron/app.js",
  "description": "Online betting and gaming platform",
  "repository": "",
  "license": "UNLICENSED",
  "scripts": {
    "start": "npm run dev",
    "dev": "cross-env NODE_ENV=development vite",
    "build": "node generate-info-before-build.cjs && cross-env NODE_ENV=production vite build",
    "build_prerender": "cross-env NODE_ENV=production vite build && node prerender.mjs",
    "build_cap": "npm run build && npx cap sync",
    "update_capgo": "npm run build && npx cap sync && npx @capgo/cli@latest bundle upload --channel production",
    "update_capgo_only": "npx @capgo/cli@latest bundle upload --channel production",
    "postinstall": "cpy --flat ./node_modules/framework7-icons/fonts/*.* ./src/fonts/ && cpy --flat ./node_modules/material-icons/iconfont/*.* ./src/fonts/",
    "electron": "electron .",
    "electron-local": "electron .",
    "electron-live": "electron . --live",
    "electron-resolume": "electron . --resolume",
    "electron-resolume-live": "electron . --resolume --live",
    "electron-dev": "concurrently \"npm run dev\" \"wait-on http://localhost:5173 && electron .\"",
    "electron-main": "electron electron/main.js",
    "electron-side": "electron electron/side.js",
    "electron-gift": "electron electron/gift.js",
    "websocket": "node electron/websocket-server.js",
    "dist": "npm run build && electron-builder"
  },
  "browserslist": [
    "IOS >= 15",
    "Safari >= 15",
    "last 5 Chrome versions",
    "last 5 Firefox versions"
  ],
  "workspaces": [
    "src/package/*"
  ],
  "dependencies": {
    "@capacitor-firebase/messaging": "^8.0.1",
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.0.1",
    "@capacitor/barcode-scanner": "^3.0.2",
    "@capacitor/browser": "^8.0.1",
    "@capacitor/camera": "^8.0.1",
    "@capacitor/cli": "^8.0.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.0.2",
    "@capacitor/device": "^8.0.1",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.1.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.1",
    "@capacitor/screen-orientation": "^8.0.1",
    "@capacitor/share": "^8.0.1",
    "@capgo/capacitor-updater": "^8.43.1",
    "@fireworks-js/react": "^2.10.8",
    "@my-common-tool/core": "workspace:*",
    "@my-common-tool/service": "workspace:*",
    "@my-common-tool/tool": "workspace:*",
    "@tawk.to/tawk-messenger-react": "^2.0.2",
    "@vitalets/google-translate-api": "^9.2.1",
    "@zxing/library": "^0.21.3",
    "axios": "^1.18.1",
    "bezier-easing": "^3.0.0",
    "bootstrap": "^5.3.8",
    "date-fns": "^4.1.0",
    "dom-to-image": "^2.6.0",
    "dom7": "^4.0.6",
    "dompurify": "^3.4.4",
    "file-saver": "^2.0.5",
    "firebase": "^12.9.0",
    "framework7": "^8.3.4",
    "framework7-react": "^8.3.4",
    "get-port": "^7.1.0",
    "howler": "^2.2.4",
    "i18next": "^25.8.0",
    "inquirer": "^12.10.0",
    "jsonc-parser": "^3.3.1",
    "koffi": "^3.3.3",
    "laravel-echo": "^2.4.0",
    "lodash": "^4.17.23",
    "motion": "^12.42.2",
    "nanoid": "^5.1.6",
    "playwright": "^1.58.0",
    "playwright-core": "^1.58.0",
    "ps-list": "^9.0.0",
    "pusher-js": "^8.6.0",
    "react": "^18.3.1",
    "react-datepicker": "^8.8.0",
    "react-dom": "^18.3.1",
    "react-draggable": "^4.5.0",
    "react-dropdown": "^1.11.0",
    "react-error-boundary": "^6.1.0",
    "react-fast-marquee": "^1.6.5",
    "react-helmet-async": "^2.0.5",
    "react-html-comment": "^2.0.16",
    "react-i18next": "^15.7.3",
    "react-icons": "^5.5.0",
    "react-indiana-drag-scroll": "^2.2.1",
    "react-player": "^3.4.0",
    "react-qrcode-logo": "^4.0.0",
    "react-responsive": "^10.0.1",
    "react-router-dom": "^7.18.1",
    "react-share": "^5.2.2",
    "react-snowfall": "^2.4.0",
    "react-spinners": "^0.17.0",
    "react-svg": "^17.2.4",
    "react-youtube": "^10.1.0",
    "recoil": "^0.7.7",
    "recoil-nexus": "^0.5.1",
    "skeleton-elements": "^4.0.1",
    "sweetalert2": "^11.26.17",
    "sweetalert2-react-content": "^5.1.1",
    "swiper": "^11.1.14",
    "uuid": "^13.0.0",
    "uuidv4": "^6.2.13",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.28.6",
    "@babel/traverse": "^7.28.6",
    "@capacitor/assets": "^3.0.5",
    "@prerenderer/renderer-puppeteer": "^1.2.4",
    "@prerenderer/rollup-plugin": "^0.3.12",
    "@vitejs/plugin-react": "^4.3.4",
    "baseline-browser-mapping": "^2.9.18",
    "chalk": "^5.6.2",
    "concurrently": "^10.0.3",
    "cpy-cli": "^5.0.0",
    "cross-env": "^7.0.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint-plugin-react": "^7.37.5",
    "fs-extra": "^11.3.3",
    "globals": "^17.4.0",
    "html5-qrcode": "^2.3.8",
    "postcss-preset-env": "^10.0.3",
    "sass": "^1.97.3",
    "serve": "^14.2.5",
    "stylelint": "^16.21.0",
    "stylelint-config-standard-scss": "^15.0.1",
    "stylelint-scss": "^6.12.1",
    "vite": "^6.2.0",
    "wait-on": "^9.1.0"
  },
  "optionalDependencies": {
    "@sparticuz/chromium": "^143.0.0"
  },
  "build": {
    "appId": "com.aftervibe.player",
    "productName": "After Vibe",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "electron/resolume/native/build/**"
    ],
    "extraResources": [
      {
        "from": "public",
        "to": "public"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}

# Central endpoint that lists every bar (tenant) staff can log into.
# Response: {"success":true,"bars":[{"id":1,"name":"...","domain":"...","url":"https://..."}]}
# After a bar is chosen on the login page, API calls go to <bar url>/api.
#
# Local (Herd):  https://aftervibe_backend.test/api/bars
# Production:    https://api.after-vibe.com/bars
VITE_BARS_URL=https://aftervibe_backend.test/api/bars

# "Check for update" on the Profile page asks the central API (VITE_BARS_URL without /bars):
#   GET <central api>/hubs/<hub>/apps/<app>/distribution/check?platform=...&currentVersion=...&channel=...
# Hub, app and release channel slugs as configured in the central distribution admin.
VITE_DISTRIBUTION_HUB_SLUG=aftervibe
VITE_DISTRIBUTION_APP_SLUG=staff
VITE_DISTRIBUTION_CHANNEL=stable
# Release environment to check against: PRODUCTION, STAGING or BETA.
VITE_DISTRIBUTION_ENVIRONMENT=PRODUCTION

# Optional: build the app for ONE bar. When set, the app always uses this bar and hides bar selection.
# Put these in a per-bar file such as .env.bar1 and build with:
#   npm run build:bar -- bar1 && npx cap copy android   (or: npx cap copy ios)
# VITE_FIXED_BAR_URL=https://bar1.after-vibe.com
# VITE_FIXED_BAR_NAME=Bar One
